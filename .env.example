PORT=8787
HOST=0.0.0.0
# Use a public HTTPS URL before enabling Discord or X posting. Private/LAN URLs are never sent to Discord.
PUBLIC_BASE_URL=https://weatherpower.app/warningcenter
# Use controller, dashboard, warningcenter, or weatherspace.
HOME_PAGE=weatherspace
# Production path mount: expose only the read-only Warning Center surface.
PUBLIC_WARNINGCENTER_ONLY=false
# Use the packaged Linux headless Chromium build on constrained shared hosting.
USE_SERVERLESS_CHROMIUM=false

# Shared WeatherPower MapLibre styles.
MAPLIBRE_STYLE_URL=https://weatherpower.app/maps/weatherpower/style.json?v=20260809-v6-tribal-hard-gate
MAPLIBRE_SATELLITE_STYLE_URL=https://weatherpower.app/maps/weatherpower/satellite-style.json?v=20260809-v6-tribal-hard-gate
WP_GEOCODING_PROVIDER=weatherpower-us
# The public Open-Meteo endpoint is for local evaluation only. Production place/ZIP search
# requires an Open-Meteo commercial customer endpoint/key or a WeatherPower-controlled endpoint.
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_API_KEY=
# Required before Route Weather is enabled. Use a WeatherPower-controlled OSRM-compatible service.
WP_OSRM_BASE_URL=
WP_ROUTING_PROVIDER=
WP_MAP_SERVICE_TIMEOUT_MS=12000

# X app credentials. These identify the app but do not authorize posting by themselves.
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here

# Optional: paste existing OAuth tokens if you already generated them.
# Otherwise use the controller's Connect X button to authorize the account.
X_USER_ACCESS_TOKEN=your_x_oauth2_user_access_token_here
X_ACCESS_TOKEN=your_x_oauth1_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_oauth1_access_token_secret_here

# WeatherPower page endpoint.
PAGE_ENDPOINT_URL=https://weatherpower.app/warningcenter
PAGE_ENDPOINT_TOKEN=
PAGE_POST_MODE=json

# Discord webhook posting.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_AUTO_POST_ENABLED=false
DISCORD_AUTO_POST_MAX_PER_REFRESH=1
DISCORD_AUTO_POST_MIN_SECONDS=3600
DISCORD_AUTO_POST_SUPPRESS_BACKFILL=true
DISCORD_USERNAME=WeatherPower
DISCORD_AVATAR_URL=

# Auto-render full U.S. active NWS warnings/watches, SPC mesoscale discussions,
# and SPC Day 1-8 outlook cards for the warningcenter page.
AUTO_RENDER_ENABLED=true
AUTO_RENDER_INTERVAL_MS=60000
# 0 means render the full active United States watch/warning feed.
AUTO_RENDER_LIMIT=0
AUTO_RENDER_CONCURRENCY=2
AUTO_RENDER_BATCH_SIZE=4
AUTO_RENDER_MAX_PER_CYCLE=8
AUTO_RENDER_BATCH_COOLDOWN_MS=2000
# Use "chrome" on a Mac with Google Chrome installed. Leave empty on hosts that use Playwright Chromium.
RENDER_BROWSER_CHANNEL=
RENDER_WORKER_TIMEOUT_MS=180000
# Cleanup is opt-in so archived card files are never removed unexpectedly.
CARD_CLEANUP_ENABLED=false
CARD_RETENTION_HOURS=24

# Official 2020 Census estimates for warning and watch polygons.
POPULATION_DATA_ENABLED=true
POPULATION_DATA_TIMEOUT_MS=9000
POPULATION_BLOCK_MAX_AREA=2.5
POPULATION_CACHE_ENTRIES=2000

# Optional WeatherPower custom products.
# FUNNY_WARNINGS_ENABLED=true adds clearly labeled funny WeatherPower cards.
# FUNNY_WARNINGS_URL can point to JSON shaped as an array, {items:[]}, or keyed objects.
FUNNY_WARNINGS_ENABLED=false
FUNNY_WARNINGS_URL=
FUNNY_WARNINGS_FILE=custom-products/funny-warnings.json

# Optional Firebase/Firestore feed for your WeatherPower "wewatches".
# Use either a Firebase Realtime Database REST URL, or a Firestore REST documents URL.
FIREBASE_WEWATCHES_URL=
FIREBASE_WEWATCHES_AUTH=
FIREBASE_WEWATCHES_API_KEY=
FIREBASE_WEWATCHES_BEARER=
CUSTOM_PRODUCTS_TIMEOUT_MS=7000

# Optional. Set this before exposing the controller on a LAN.
CONTROLLER_TOKEN=

# WeatherPower Live: WeBot voice through OpenAI (optional; the default voice is OpenAI Alloy via Puter.js in the stream page)
OPENAI_API_KEY=
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_DAILY_CHARS=150000

# WeatherPower Live: live cameras from WeatherPower Traffic (Camera Wall). Use a viewer account from that app.
CAMERA_API_BASE=http://127.0.0.1:8778
CAMERA_API_USER=
CAMERA_API_PASS=
# true = also show local/private feeds served by WeatherPower Traffic (default: public DOT feeds only)
CAMERA_ALLOW_LOCAL=false
